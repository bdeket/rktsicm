                         (* (expt x2 2) ,√1+... (((partial ,n) f) (up x0 x1 x2)))
                         (* 2 ,(string->symbol (format "x~a" n)) ,√1+... (f (up x0 x1 x2)))
                         (* ,√1+... (((partial ,n) f) (up x0 x1 x2)))))
                   `(down (/ ,(partials 0)
                             (sqrt (+ 1 (* (expt x0 2) (expt x1 2)) (* (expt x0 2) (expt x2 2)) (expt x1 4) (* 2 (expt x1 2) (expt x2 2)) (expt x2 4)
                                      (expt x0 2) (* 2 (expt x1 2)) (* 2 (expt x2 2)))))
