                                         (/ (((partial 2) f) (up x0 x1 x2 x3)) x1)
                                         (/ (((partial 3) f) (up x0 x1 x2 x3)) (* x1 (sin x2)))))

    (check-ortho S2-spherical '(down (((partial 0) f) (up x0 x1))
