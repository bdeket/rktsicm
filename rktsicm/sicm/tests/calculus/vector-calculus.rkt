                                     (/ (((partial 2) f) (up r theta phi)) (* r (sin theta)))))
    (check-ortho R4-rect '(down (((partial 0) f) (up x0 x1 x2 x3))
                                (((partial 1) f) (up x0 x1 x2 x3))
                                (((partial 2) f) (up x0 x1 x2 x3))
                                (((partial 3) f) (up x0 x1 x2 x3))))
    (check-ortho R4-cyl '(down (((partial 0) f) (up x0 x1 x2 x3))
