     (check-ortho S1-gnomic (down (/ 1 (+ 1 (expt 'x0 2))))))

    (check-ortho R2-rect '(down (((partial 0) f) (up x0 x1))
                                (((partial 1) f) (up x0 x1))))
    (check-ortho R2-polar '(down (((partial 0) f) (up r theta))
