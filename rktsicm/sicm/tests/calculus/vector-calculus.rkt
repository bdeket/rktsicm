    (check-Lamé S3-tilted    (down 1 (sin 'x0) (* (sin 'x1) (sin 'x0))))
    (check-Lamé S3-gnomic
                (let ([x0 'x0][x1 'x1][x2 'x2])
                  (let ([√1+... (sqrt (+ 1 (expt x0 2) (expt x1 2) (expt x2 2)))])
                    (down (/ (sqrt (+ 1 (* (expt x0 2) (expt x1 2)) (* (expt x0 2) (expt x2 2)) (expt x1 4) (* 2 (expt x1 2) (expt x2 2)) (expt x2 4) (expt x0 2) (* 2 (expt x1 2)) (* 2 (expt x2 2))))
                             (+ (* (expt x0 2) √1+...) (* (expt x1 2) √1+...) (* (expt x2 2) √1+...) √1+...))
                        (/ (sqrt (+ 1 (expt x0 4) (* (expt x0 2) (expt x1 2)) (* 2 (expt x0 2) (expt x2 2)) (* (expt x1 2) (expt x2 2)) (expt x2 4) (* 2 (expt x0 2)) (expt x1 2) (* 2 (expt x2 2))))
                           (+ (* (expt x0 2) √1+...) (* (expt x1 2) √1+...) (* (expt x2 2) √1+...) √1+...))
                        (/ (sqrt (+ 1 (expt x0 4) (* 2 (expt x0 2) (expt x1 2)) (* (expt x0 2) (expt x2 2)) (expt x1 4) (* (expt x1 2) (expt x2 2)) (* 2 (expt x0 2)) (* 2 (expt x1 2)) (expt x2 2)))
                           (+ (* (expt x0 2) √1+...) (* (expt x1 2) √1+...) (* (expt x2 2) √1+...) √1+...))))))
    (check-Lamé S3-stereographic (down (/ 2 (+ 1 (expt 'x0 2) (expt 'x1 2) (expt 'x2 2)))
                                       (/ 2 (+ 1 (expt 'x0 2) (expt 'x1 2) (expt 'x2 2)))
                                       (/ 2 (+ 1 (expt 'x0 2) (expt 'x1 2) (expt 'x2 2)))))
    (check-Lamé Euler-angles     '(down (sqrt 2) (sqrt 2) (sqrt 2)))
    (check-Lamé alternate-angles '(down (sqrt 2) (sqrt 2) (sqrt 2))))
