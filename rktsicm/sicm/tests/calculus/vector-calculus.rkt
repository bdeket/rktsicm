    (check-Lamé R4-cyl (down 1 'x0 1 1))
    (check-Lamé spacetime-rect (down 1 1 1 1))
    (check-Lamé spacetime-sphere (down 1 1 'x1 (* 'x1 (sin 'x2))))

    (check-Lamé S1-circular (down 1))
    (check-Lamé S1-slope (down (/ 2 (+ 1 (expt 'x0 2)))))
    (check-Lamé S1-gnomic (down (/ 1 (+ 1 (expt 'x0 2)))))
    (check-Lamé S2-spherical (down 1 (sin 'x0)))
    (check-Lamé S2-tilted (down 1 (sin 'x0)))
    (check-Lamé S2-stereographic (down (/ 2 (+ 1 (expt 'x0 2) (expt 'x1 2)))
                                       (/ 2 (+ 1 (expt 'x0 2) (expt 'x1 2)))))

    (define 2gnom
      (let ([x0 'x0][x1 'x1])
        (down (/ (sqrt (+ 1 (* (expt x0 2) (expt x1 2)) (expt x1 4) (expt x0 2) (* 2 (expt x1 2))))
                 (+ (* (expt x0 2) (sqrt (+ 1 (expt x0 2) (expt x1 2))))
                    (* (expt x1 2) (sqrt (+ 1 (expt x0 2) (expt x1 2))))
                    (sqrt (+ 1 (expt x0 2) (expt x1 2)))))
              (/ (sqrt (+ 1 (expt x0 4) (* (expt x0 2) (expt x1 2)) (* 2 (expt x0 2)) (expt x1 2)))
                 (+ (* (expt x0 2) (sqrt (+ 1 (expt x0 2) (expt x1 2))))
                    (* (expt x1 2) (sqrt (+ 1 (expt x0 2) (expt x1 2))))
                    (sqrt (+ 1 (expt x0 2) (expt x1 2))))))))
    (check-Lamé S2-gnomic 2gnom)
    (check-Lamé S2p-spherical (down 1 (sin 'x0)))
    (check-Lamé S2p-tilted    (down 1 (sin 'x0)))
    (check-Lamé S2p-stereographic (down (/ 2 (+ 1 (expt 'x0 2) (expt 'x1 2)))
                                        (/ 2 (+ 1 (expt 'x0 2) (expt 'x1 2)))))
    (check-Lamé S2p-gnomic 2gnom)
