    (define (polar-metric v1 v2)
      (+ (* (dr v1) (dr v2))
         (* (square r) (* (dtheta v1) (dtheta v2)))))
    (check-simplified? (((basis->1form-basis polar-basis)
                         ((gradient polar-metric polar-basis)
                          (literal-manifold-function 'f polar)))
                        polar-point)
                       '(up (((partial 0) f) (up r theta))
                            (/ (((partial 1) f) (up r theta)) (expt r 2)))))
