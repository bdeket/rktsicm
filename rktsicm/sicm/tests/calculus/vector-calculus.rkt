    (check-ortho S2-tilted '(down (((partial 0) f) (up x0 x1))
                                  (/ (((partial 1) f) (up x0 x1)) (sin x0))))
    ;; slow
    (check-ortho S2-stereographic '(down (+ (* 1/2 (expt x0 2) (((partial 0) f) (up x0 x1)))
                                            (* 1/2 (expt x1 2) (((partial 0) f) (up x0 x1)))
                                            (* x0 (f (up x0 x1)))
                                            (* 1/2 (((partial 0) f) (up x0 x1))))
                                         (+ (* 1/2 (expt x0 2) (((partial 1) f) (up x0 x1)))
                                            (* 1/2 (expt x1 2) (((partial 1) f) (up x0 x1)))
                                            (* x1 (f (up x0 x1)))
                                            (* 1/2 (((partial 1) f) (up x0 x1))))))

    (define 2gnom
      '(down (/ (+ (* (expt x0 2) (sqrt (+ 1 (expt x0 2) (expt x1 2))) (((partial 0) f) (up x0 x1)))
                   (* (expt x1 2) (sqrt (+ 1 (expt x0 2) (expt x1 2))) (((partial 0) f) (up x0 x1)))
                   (* 2 x0 (sqrt (+ 1 (expt x0 2) (expt x1 2))) (f (up x0 x1)))
                   (* (sqrt (+ 1 (expt x0 2) (expt x1 2))) (((partial 0) f) (up x0 x1))))
                (sqrt (+ 1 (* (expt x0 2) (expt x1 2)) (expt x1 4) (expt x0 2) (* 2 (expt x1 2)))))
             (/ (+ (* (expt x0 2) (sqrt (+ 1 (expt x0 2) (expt x1 2))) (((partial 1) f) (up x0 x1)))
                   (* (expt x1 2) (sqrt (+ 1 (expt x0 2) (expt x1 2))) (((partial 1) f) (up x0 x1)))
                   (* 2 x1 (sqrt (+ 1 (expt x0 2) (expt x1 2))) (f (up x0 x1)))
